  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Sari
    text: Halo! Apa kamu sudah tahu tentang elemen monster?
  - speaker: Sari
    text: Api mengalahkan Tumbuhan, Tumbuhan mengalahkan Air, dan Air mengalahkan
      Api!
  - speaker: Sari
    text: Listrik sangat kuat melawan Air, tapi berhati-hatilah di dalam Gua Petir!
